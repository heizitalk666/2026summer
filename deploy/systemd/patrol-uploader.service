[Unit]
Description=RK3576 巡检系统 · 证据上传（patrol.uploader.node）
PartOf=patrol.target
After=network-online.target
After=patrol-gateway.service

[Service]
Type=simple
User=@USER@
SupplementaryGroups=dialout video
WorkingDirectory=@PREFIX@
Environment=PYTHONPATH=@PREFIX@ PYTHONUNBUFFERED=1 PATROL_CONFIG=@PREFIX@/configs/rk3576.yaml
ExecStart=@PREFIX@/venv/bin/python -m patrol.uploader.node --config @PREFIX@/configs/rk3576.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=patrol.target
